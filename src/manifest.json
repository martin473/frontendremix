{
  "manifest_version": 3,
  "name": "Frontend Remix",
  "version": "1.1.0",
  "description": "Detect and swap rendered fonts on any page, and restyle the web with 5 design systems.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/background.js"
  },
  "action": {
    "default_title": "Frontend Remix",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/style-engine.js", "content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*", "assets/*/*", "assets/*/*/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
